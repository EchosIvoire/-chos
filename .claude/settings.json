{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node formation/build.mjs)",
      "Bash(npm run build)",
      "Bash(npm run audit:fast)",
      "Bash(npm run audit)",
      "Bash(npm ci)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r \".tool_input.file_path // .tool_response.filePath // empty\" | { read -r f; case \"$f\" in */formation/data/*|*/formation/build.mjs|*/formation/assets/img/*) cd \"$(git rev-parse --show-toplevel)\" && node formation/build.mjs >/dev/null && printf \"%s\" \"{\\\"systemMessage\\\":\\\"Pages de leçon régénérées (formation/build.mjs).\\\"}\" ;; esac; } 2>/dev/null || true",
            "timeout": 60,
            "statusMessage": "Régénération des pages de leçon…"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/session-start.mjs\" 2>/dev/null || true",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
